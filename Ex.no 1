df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'])
sales_over_time = df.groupby(df['InvoiceDate'].dt.date)['Sales'].sum()

plt.plot(sales_over_time)
plt.title("Sales Trend Over Time")
plt.xlabel("Date")
plt.ylabel("Sales")
plt.show()

